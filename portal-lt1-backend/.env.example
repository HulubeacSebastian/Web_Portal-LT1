# Copiaza:  copy .env.example .env
# Fisierul .env este doar pe fiecare masina (PC / server) — nu intra in git.

# Calea e relativa la folderul prisma/ (unde e schema.prisma), NU la radacina
# proiectului — asa rezolva Prisma orice cale "file:" relativa, indiferent de
# directorul din care rulezi comanda. Nu adauga "prisma/" in fata.
DATABASE_URL="file:./dev.db"
PORT=3000

# Obligatoriu peste tot (dev + productie) — fara asta, autentificarea foloseste
# un secret implicit nesigur ("lt1-dev-secret"), vizibil oricui in codul sursa.
JWT_SECRET=schimba-cu-un-secret-lung-si-aleator

# --- Varianta PC (dev local, IntelliJ Run) ---
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PORTAL_DEV_HTTP=true
SSL_KEY_PATH=certs/dev.key
SSL_CERT_PATH=certs/dev.crt

# --- Varianta SERVER Oracle (inlocuieste liniile de mai sus pe VM) ---
# NODE_ENV=production
# PORTAL_PRODUCTION=true
# ALLOWED_ORIGINS=https://portal-lt1.duckdns.org
# PORTAL_DEV_HTTP=true
# (fara SSL_KEY_PATH / SSL_CERT_PATH)
# Nu pastra dev-network.local.env activ pe VM-ul de productie.

MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=portal_lt1_chat
AUTH_EXPOSE_DEV_CODES=true

# --- Email reset parola (optional; daca lipseste, in dev tokenul apare in UI) ---
# PUBLIC_APP_URL=https://portal-lt1.duckdns.org
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-user
# SMTP_PASS=your-password
# MAIL_FROM="Portal LT1 <noreply@lt1.ro>"
# Obligatoriu pentru formularul Contact (mesaje catre secretariat):
# MAIL_CONTACT_TO="portal.lt1.suport@gmail.com"

# --- Varianta Vercel (productie serverless) ---
# DATABASE_URL="libsql://numele-bazei-tale.turso.io"
# TURSO_AUTH_TOKEN=token-generat-cu-turso-db-tokens-create
# NODE_ENV=production
# ALLOWED_ORIGINS=https://numele-proiectului-frontend.vercel.app
# Vercel seteaza singur variabila VERCEL=1 — codul o foloseste ca sa dezactiveze
# temporar chat-ul (WebSocket) si uploadul de fisiere (disc efemer pe serverless).
